# Browser requests stay same-origin through the fixed read-only /sgw-api route.
NEXT_PUBLIC_SGW_API_URL=/sgw-api

# Server-side telemetry upstream. Keep SGW-C management bound to loopback; for
# remote development, point this at a local SSH tunnel rather than exposing it.
SGW_API_UPSTREAM=http://127.0.0.1:8080
